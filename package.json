{
  "name": "whisper-transcriber",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "node-fetch": "3.3.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.7",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/browser": "^5.0.5",
    "ajv": "^8.20.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "happy-dom": "^21.0.3",
    "jsdom": "^30.1.3",
    "less": "^4.9.1",
    "playwright": "^1.64.1",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "clean": "rm -rf build/.vite build/assets node_modules/.vite dist .eslintcache",
    "validate": "tsc --noEmit && eslint src --ext .ts,.tsx",
    "start": "npm run build && npx http-server build -p 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src/__tests__/unit",
    "test:integration": "vitest run src/__tests__/integration",
    "test:e2e": "vitest run e2e --environment happy-dom",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --reporter=json"
  }
}
